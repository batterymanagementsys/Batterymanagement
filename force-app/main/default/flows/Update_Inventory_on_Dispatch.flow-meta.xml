<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Updates Battery inventory status and source inventory balance
when a posted DISPATCH inventory transaction is created.</description>
    <environments>Default</environments>
    <formulas>
        <name>NewAvailableQuantity</name>
        <dataType>Number</dataType>
        <expression>{!Get_Source_Inventory_Balance.Available_Quantity__c} - 1</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>NewDispatchedQuantity</name>
        <dataType>Number</dataType>
        <expression>{!Get_Source_Inventory_Balance.Dispatched_Quantity__c} + 1</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>Update Inventory on Dispatch {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Update Inventory on Dispatch</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Battery_records</name>
        <label>Get Battery records</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Update_Inventory_on_Dispatch</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Battery__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Battery__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Source_Inventory_Balance</name>
        <label>Get Source Inventory Balance</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Update_Source_Inventory_Balance</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Warehouse__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Source_Location__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Batch_Number__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Batch_Number__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Inventory_Balance__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Inventory_on_Dispatch</name>
        <label>Update Inventory on Dispatch</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Source_Inventory_Balance</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Battery__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Current_Location__c</field>
            <value>
                <elementReference>$Record.Destination_Location__r.Name</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>FIFO_Eligible__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Inventory_Status__c</field>
            <value>
                <stringValue>Dispatched</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Last_Movement_Date_Time__c</field>
            <value>
                <elementReference>$Record.Transaction_Date_Time__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>In Transit</stringValue>
            </value>
        </inputAssignments>
        <object>Battery__c</object>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Source_Inventory_Balance</name>
        <label>Update Source Inventory Balance</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Source_Inventory_Balance.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Available_Quantity__c</field>
            <value>
                <elementReference>NewAvailableQuantity</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Dispatched_Quantity__c</field>
            <value>
                <elementReference>NewDispatchedQuantity</elementReference>
            </value>
        </inputAssignments>
        <object>Inventory_Balance__c</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Battery_records</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Transaction_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>DISPATCH</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Posted</stringValue>
            </value>
        </filters>
        <object>Inventory_Transaction__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
