<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Manufacturing_Date_Cannot_Be_Future</fullName>
    <active>true</active>
    <description>Manufacturing Date cannot be in the future.</description>
    <errorConditionFormula>Manufacturing_Date__c &gt; TODAY()</errorConditionFormula>
    <errorDisplayField>Manufacturing_Date__c</errorDisplayField>
    <errorMessage>Manufacturing Date cannot be in the future.</errorMessage>
</ValidationRule>
